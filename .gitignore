node_modules
dist
.DS_Store

# Khoá API — không bao giờ commit
.env

# Video và mọi thứ render ra
out/
dist/

# Slide gốc của giáo trình: tài liệu có bản quyền của nhà xuất bản,
# để trên máy chứ không đưa lên git
docs/*.pptx

# Code ngoài, cài lại bằng lệnh trong README
vendor/
whisper.cpp/

# Agent skills — cài lại bằng: npx remotion skills add.
# Loại NỘI DUNG chứ không loại thư mục: git không bỏ ignore được file nằm trong
# một thư mục đã bị loại, nên "!.agents/rules/" chỉ ăn khi viết ".agents/*".
.agents/*
!.agents/rules/
.claude/

# Ảnh chụp khung hình khi review thiết kế, sinh lại được
.impeccable/review/
.impeccable/mocks/
.impeccable/hook.cache.json

# Cờ đánh dấu của pipeline audio
*.lufs
*.sfx

# Python bytecode
__pycache__/
*.pyc

# Sổ ghi lượt gọi Gemini trong ngày
.gemini-usage.json

# Nhân vật độc nhất của kênh
char_reference/
public/characters/

